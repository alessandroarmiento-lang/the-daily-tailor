# The Daily Tailor — local overrides (optional)

NEXT_PUBLIC_PRODUCT_NAME=The Daily Tailor
NEXT_PUBLIC_PRODUCT_TAGLINE=Il giornale del mattino in una pagina, su misura per te

# Weather location
WEATHER_CITY=Milano
WEATHER_LAT=45.4642
WEATHER_LON=9.1900

# open-meteo (default) | auto | weatherkit | mock
WEATHER_PROVIDER=open-meteo

# Optional WeatherKit (not required — Open-Meteo is the product default)
# WEATHERKIT_TEAM_ID=XXXXXXXXXX
# WEATHERKIT_KEY_ID=XXXXXXXXXX
# WEATHERKIT_SERVICE_ID=com.example.the-daily-tailor
# WEATHERKIT_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----"
# WEATHERKIT_PRIVATE_KEY_PATH=/absolute/path/AuthKey_XXXXXX.p8

# World news RSS — Il Post sezione Mondo (trailing slash required)
NEWS_FEED_URL=https://www.ilpost.it/mondo/feed/
NEWS_MAX_ITEMS=4

# Data sources — on Mac darwin defaults to eventkit / applemail if unset
# REMINDERS_SOURCE=eventkit
# ACTION_EMAIL_SOURCE=applemail
# CALENDAR_SOURCE=eventkit
REMINDERS_SOURCE=mock
REMINDERS_MAX_ITEMS=4
ACTION_EMAIL_SOURCE=mock
ACTION_EMAIL_MAX_ITEMS=3
CALENDAR_SOURCE=mock
CALENDAR_HORIZON_DAYS=4
CALENDAR_MAX_EVENTS_PER_DAY=2

NEWSPAPER_TIMEZONE=Europe/Rome

# Optional absolute path for edition JSON store (default: ./data/editions)
# EDITIONS_DIR=/Users/alessandroarmiento/Library/Application Support/TheDailyTailor/editions
