# The Daily Tailor — local overrides (optional)

NEXT_PUBLIC_PRODUCT_NAME=The Daily Tailor
NEXT_PUBLIC_PRODUCT_TAGLINE=Il giornale del mattino in una pagina, su misura per te

# Weather location
WEATHER_CITY=Roma
WEATHER_LAT=41.9028
WEATHER_LON=12.4964

# auto | weatherkit | open-meteo | mock
# auto uses Apple WeatherKit when credentials below are set; otherwise Open-Meteo (with precip).
WEATHER_PROVIDER=auto

# Apple WeatherKit (same data family as iPhone Weather). Requires Apple Developer Program.
# WEATHERKIT_TEAM_ID=XXXXXXXXXX
# WEATHERKIT_KEY_ID=XXXXXXXXXX
# WEATHERKIT_SERVICE_ID=com.example.the-daily-tailor
# Inline PEM (use \n for newlines) OR path to AuthKey_XXXX.p8:
# WEATHERKIT_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----"
# WEATHERKIT_PRIVATE_KEY_PATH=/absolute/path/AuthKey_XXXXXX.p8

# World news RSS (capped for one A4 page)
NEWS_FEED_URL=https://feeds.bbci.co.uk/news/world/rss.xml
NEWS_MAX_ITEMS=4

# Data sources on this machine
REMINDERS_SOURCE=mock
REMINDERS_MAX_ITEMS=4
ACTION_EMAIL_SOURCE=mock
ACTION_EMAIL_MAX_ITEMS=3
CALENDAR_SOURCE=mock
CALENDAR_HORIZON_DAYS=4
CALENDAR_MAX_EVENTS_PER_DAY=2

NEWSPAPER_TIMEZONE=Europe/Rome
