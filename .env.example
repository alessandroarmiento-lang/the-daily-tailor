# The Daily Tailor — local overrides (optional)

NEXT_PUBLIC_PRODUCT_NAME=The Daily Tailor
NEXT_PUBLIC_PRODUCT_TAGLINE=Il giornale del mattino in una pagina, su misura per te

# Weather location
WEATHER_CITY=Milano
WEATHER_LAT=45.4642
WEATHER_LON=9.1900

# open-meteo (default) | auto | weatherkit | mock
WEATHER_PROVIDER=open-meteo

# Optional WeatherKit (not required — Open-Meteo is the product default)
# WEATHERKIT_TEAM_ID=XXXXXXXXXX
# WEATHERKIT_KEY_ID=XXXXXXXXXX
# WEATHERKIT_SERVICE_ID=com.example.the-daily-tailor
# WEATHERKIT_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----"
# WEATHERKIT_PRIVATE_KEY_PATH=/absolute/path/AuthKey_XXXXXX.p8

# World news RSS — Il Post sezione Mondo (trailing slash required)
NEWS_FEED_URL=https://www.ilpost.it/mondo/feed/
NEWS_MAX_ITEMS=6

# ---------------------------------------------------------------------------
# Personal data sources
# auto = prefer headless IMAP/CalDAV when credentials exist (Mac OFF),
#        else Apple Mail / EventKit on darwin (Mac awake + TCC).
# Never leave silent mocks: missing creds → clear UI error.
# ---------------------------------------------------------------------------
ACTION_EMAIL_SOURCE=auto
CALENDAR_SOURCE=auto
REMINDERS_SOURCE=auto
# Force mock only for demos: ACTION_EMAIL_SOURCE=mock etc.

REMINDERS_MAX_ITEMS=6
ACTION_EMAIL_MAX_ITEMS=4
CALENDAR_HORIZON_DAYS=4
# Agenda shows every event per day (no per-day cap).

# --- IMAP (Mac-off email generation) ---
# Apple ID app-specific password: https://appleid.apple.com
# Fill these in .env.local (never commit real passwords):
ICLOUD_MAIL_USER=
ICLOUD_MAIL_APP_PASSWORD=
# Gmail app password: https://myaccount.google.com/apppasswords
GMAIL_USER=
GMAIL_APP_PASSWORD=

# --- CalDAV / CardDAV (Mac-off calendar, reminders, contacts filter) ---
# Reuses ICLOUD_MAIL_* if unset. Optional overrides:
# ICLOUD_CALDAV_USER=
# ICLOUD_CALDAV_APP_PASSWORD=
# ICLOUD_CALDAV_URL=https://caldav.icloud.com
# ICLOUD_CARDDAV_USER=
# ICLOUD_CARDDAV_APP_PASSWORD=
# Optional Google Calendar CalDAV (often needs OAuth; set URL only if you have it):
# GOOGLE_CALDAV_URL=
# GOOGLE_CALDAV_USER=
# GOOGLE_CALDAV_APP_PASSWORD=

NEWSPAPER_TIMEZONE=Europe/Rome

# Optional absolute path for edition JSON store (default: ./data/editions)
# EDITIONS_DIR=/Users/alessandroarmiento/Library/Application Support/TheDailyTailor/editions
