# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# local edition snapshots + adapter caches (Mac morning sheet)
/data/editions/
/.cache/

# Apple auth material — never commit
*.p8
AuthKey_*.p8


# personal morning editions (email / reminders / calendar snapshots)
/data/editions/*.json

# per-section Mac adapter cache (osascript results)
.cache/

# vercel
.vercel

# local Cursor project rules / agent state
.cursor/

# typescript
*.tsbuildinfo
next-env.d.ts

# Author-only UI prefs (Italian default). Public clones → English.
/public/owner-prefs.json

